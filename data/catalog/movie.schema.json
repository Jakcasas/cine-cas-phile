{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cine film metadata 1.0",
  "type": "object",
  "required": [
    "movie_id",
    "title",
    "genres",
    "year"
  ],
  "properties": {
    "movie_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genres": {
      "type": "string"
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2200
    },
    "poster_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}