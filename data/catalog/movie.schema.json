{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cine film metadata 1.0",
  "type": "object",
  "required": [
    "movie_id",
    "title",
    "genres",
    "year"
  ],
  "properties": {
    "movie_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genres": {
      "type": "string"
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2200
    },
    "poster_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "release": {
      "type": "object",
      "required": [
        "date",
        "region",
        "source",
        "url",
        "checked_at"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "region": {
          "enum": [
            "VN",
            "US",
            "GB",
            "FR",
            "JP",
            "KR"
          ]
        },
        "source": {
          "enum": [
            "IMDb",
            "Galaxy Cinema"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "cinema_status": {
      "type": "object",
      "required": [
        "status",
        "region",
        "source",
        "url",
        "checked_at"
      ],
      "properties": {
        "status": {
          "const": "now"
        },
        "region": {
          "const": "VN"
        },
        "source": {
          "const": "Galaxy Cinema"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "releases": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "date",
          "region",
          "source",
          "url",
          "checked_at"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "region": {
            "enum": [
              "VN",
              "US",
              "GB",
              "FR",
              "JP",
              "KR"
            ]
          },
          "source": {
            "enum": [
              "IMDb",
              "Galaxy Cinema"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "title_aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}
