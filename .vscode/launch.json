{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cine (cas) phile. 1.0 — full website",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/preview_netlify.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Build Netlify site",
      "serverReadyAction": {
        "pattern": "Netlify preview (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Cine (cas) phile. 1.0 - Python research API",
      "type": "debugpy",
      "request": "launch",
      "module": "src.cli",
      "args": [
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Prepare Cine 1.0"
    }
  ]
}
