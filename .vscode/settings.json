{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-q"],
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/runtime/**": true,
    "**/artifacts/**": true,
    "**/data/raw/**": true
  }
}
